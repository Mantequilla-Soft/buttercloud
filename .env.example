# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/buttercloud
MONGODB_DB_NAME=buttercloud

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=3600

# MinIO (for admin operations, credential management)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_INTERNAL_ENDPOINT=http://localhost:9000

# API Keys & Secrets
API_KEY_HASH_ROUNDS=10
PASSWORD_HASH_ROUNDS=10

# Quota Enforcement
MAX_API_KEYS_PER_USER=10
MAX_BUCKETS_PER_USER=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Credentials (for creating test users)
ADMIN_EMAIL=admin@buttercloud.com
ADMIN_PASSWORD=AdminPassword123!

# Email / SMTP
# Works with any SMTP provider. Recommended free option: Resend (resend.com)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=billing@yourdomain.com

# HIVE Payments
# Your HIVE account username (without @). Leave blank to disable crypto payments.
HIVE_ACCOUNT=yourhiveaccount
# HIVE_API_URL=https://api.hive.blog

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
