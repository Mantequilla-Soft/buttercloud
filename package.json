{
  "name": "buttercloud",
  "version": "1.0.0",
  "description": "S3-compatible storage rental platform on MinIO",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:all": "concurrently -n api,web -c cyan,yellow \"npm run dev\" \"npm run dev:frontend\"",
    "setup-db": "node scripts/setup-db.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "s3",
    "minio",
    "storage",
    "gateway"
  ],
  "author": "menosoft",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0",
    "nodemailer": "^8.0.7",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.1.0",
    "vitest": "^4.1.6"
  }
}
